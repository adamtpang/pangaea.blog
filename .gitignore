# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local
.env*.local

# macOS / Windows
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/
*.swp

# vercel
.vercel

# Claude Code worktrees (may contain API keys in settings.local.json)
.claude/worktrees/
.claude/settings.local.json
.claude/settings.local.json*

# Local-only working files synced via OneDrive (not part of the public site)
src/content/drafts/
src/content/inbox/
src/content/pilot/
adamanack/sources/twitter/

# scripts/ holds real, committed setup docs (README-*-mcp.md, install
# scripts, the vendored Ableton remote script) - only scratch clones under it
# are ignored, not the directory itself. See scripts/README-*-mcp.md.
scripts/*-src/
scripts/*/.venv/

# Separated audio stems (big, derived, not source)
stems/
.env*

# Demucs local install: model weights cache to ~/.cache/huggingface, but the
# venv and any separated output / test audio dropped in scripts/demucs/ stay
# local. See scripts/README-demucs.md.
scripts/demucs/separated/
scripts/demucs/*.wav
scripts/demucs/*.mp3
scripts/demucs/*.flac

# firecrawl CLI scratch output: raw scraped copies of external pages, used
# for research, never the source of truth for anything committed here.
.firecrawl/
.tiering.json
