{
  "title": "Rockefeller: The Flywheel",
  "fps": 30,
  "beats": [
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "1859. A 19-year-old bookkeeper, $400 a year.", "quote": "This is not a story about luck.", "audio": "rockefeller/01-hook.mp3", "seconds": 16.2 },
    { "layout": "title", "text": "ROCKEFELLER: THE FLYWHEEL", "audio": "rockefeller/02-title.mp3", "seconds": 2.184 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "The origin was the opposite of an advantage.", "quote": "Great fortunes were built by people who succeeded because of, not in spite of, poverty.", "source": "38 Letters to His Son", "audio": "rockefeller/03-p1a.mp3", "seconds": 9.288 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "Skip the struggle, lose the fortune.", "quote": "Shirtsleeves to shirtsleeves in three generations.", "source": "38 Letters to His Son", "audio": "rockefeller/04-p1b.mp3", "seconds": 7.056 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "Destiny is your actions, not your origins.", "quote": null, "audio": "rockefeller/05-p1c.mp3", "seconds": 18.816 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "Know your numbers like a poet knows words.", "quote": "The good ones know more.", "source": "How Rockefeller Worked", "audio": "rockefeller/06-p2a.mp3", "seconds": 13.104 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "Effort and information. Not talent.", "quote": "They did not actually know when they were making money or losing money.", "source": "Rockefeller's Autobiography", "audio": "rockefeller/07-p2b.mp3", "seconds": 12.336 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "Rivals guessed. He measured.", "quote": null, "audio": "rockefeller/08-p2c.mp3", "seconds": 6.816 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "Find the cost that matters and own it.", "quote": "All is not as it seems on the outside.", "source": "How Rockefeller Worked", "audio": "rockefeller/09-p3a.mp3", "seconds": 17.496 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "Every dollar kept, never distributed.", "quote": "We were accustomed to prepare for financial emergencies long before we needed the funds.", "source": "Rockefeller's Autobiography", "audio": "rockefeller/10-p3b.mp3", "seconds": 12.12 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "The greatest borrower Larry Ellison ever saw.", "quote": "We must try and not lose our nerve when the market gets to the bottom.", "source": "How Rockefeller Worked", "audio": "rockefeller/11-p3c.mp3", "seconds": 18.576 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "The flywheel: raise, rebate, buy, repeat.", "quote": null, "audio": "rockefeller/12-p4a.mp3", "seconds": 17.952 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "He rarely just crushed a rival.", "quote": "You cannot have a winning cooperation except by willing partners.", "source": "How Rockefeller Worked", "audio": "rockefeller/13-p4b.mp3", "seconds": 7.344 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "A company of founders, not a monopoly of casualties.", "quote": "You cannot fight a technological phenomenon.", "source": "How Rockefeller Worked", "audio": "rockefeller/14-p4c.mp3", "seconds": 17.976 },
    { "layout": "photo", "photo": "rockefeller-photos/tycoon-1895.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "He adapted the wheel instead of defending it.", "quote": null, "audio": "rockefeller/15-p4d.mp3", "seconds": 4.92 },
    { "layout": "photo", "photo": "rockefeller-photos/mid-1875.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "He ran almost silent.", "quote": "Bad boys move in silence.", "source": "Rockefeller's Autobiography", "audio": "rockefeller/16-p5a.mp3", "seconds": 7.728 },
    { "layout": "photo", "photo": "rockefeller-photos/mid-1875.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "No brass band before the battle.", "quote": null, "audio": "rockefeller/17-p5b.mp3", "seconds": 8.712 },
    { "layout": "photo", "photo": "rockefeller-photos/mid-1875.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "The same core team, for decades.", "quote": "You do not want turnover on your core team. That knowledge compounds.", "source": "Rockefeller's Autobiography", "audio": "rockefeller/18-p5c.mp3", "seconds": 13.824 },
    { "layout": "photo", "photo": "rockefeller-photos/mid-1875.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "He funded the disagreement himself.", "quote": "A check separates conviction from conversation.", "source": "Rockefeller's Autobiography", "audio": "rockefeller/19-p5d.mp3", "seconds": 13.176 },
    { "layout": "photo", "photo": "rockefeller-photos/mid-1875.jpg", "photoCredit": "Public domain · Wikimedia Commons", "text": "The disagreement cost him, not them.", "quote": null, "audio": "rockefeller/20-p5e.mp3", "seconds": 8.232 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "One more thing, trained like a skill.", "quote": "A dangerous optimist.", "source": "38 Letters to His Son", "audio": "rockefeller/21-p6a.mp3", "seconds": 9.96 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "A discipline, not a mood.", "quote": "What destiny gives us is not the wine of disappointment but the cup of opportunity.", "source": "38 Letters to His Son", "audio": "rockefeller/22-p6b.mp3", "seconds": 14.472 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "The only part that's actually repeatable.", "quote": null, "audio": "rockefeller/23-p6c.mp3", "seconds": 20.184 },
    { "layout": "photo", "photo": "rockefeller-photos/young-1872.png", "photoCredit": "Public domain · Wikimedia Commons", "text": "This is one figure. summon.guide has more.", "quote": "Every quote in this film is real.", "audio": "rockefeller/24-outro.mp3", "seconds": 9.24 }
  ]
}
