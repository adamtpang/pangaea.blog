---
import Base from '../../layouts/Base.astro';
import EpisodeChapters from '../../components/podcast/EpisodeChapters.astro';
import EpisodeDisclosure from '../../components/podcast/EpisodeDisclosure.astro';
import EpisodeLabel from '../../components/podcast/EpisodeLabel.astro';
import EpisodeMedia from '../../components/podcast/EpisodeMedia.astro';
import EpisodeSources from '../../components/podcast/EpisodeSources.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { episodeDisplayTitle, PODCAST_TITLE } from '../../lib/podcast';

export async function getStaticPaths() {
  const episodes = (await getCollection('episodes', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
  );

  return episodes.map((episode, index) => ({
    params: { slug: episode.slug },
    props: {
      episode,
      previous: index > 0 ? episodes[index - 1] : null,
      next: index < episodes.length - 1 ? episodes[index + 1] : null,
    },
  }));
}

interface Props {
  episode: CollectionEntry<'episodes'>;
  previous: CollectionEntry<'episodes'> | null;
  next: CollectionEntry<'episodes'> | null;
}

const { episode, previous, next } = Astro.props;
const { Content } = await episode.render();
const { data } = episode;
const displayTitle = episodeDisplayTitle(data);
const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={displayTitle + ' | ' + PODCAST_TITLE} description={data.blurb}>
  <article class="episode-page">
    <header class="episode-header">
      <p><a href="/podcast/">{PODCAST_TITLE}</a></p>
      <EpisodeLabel format={data.format} number={data.format_number} />
      <h1>{data.title}</h1>
      {data.blurb && <p class="episode-dek">{data.blurb}</p>}

      <dl class="episode-metadata">
        <div>
          <dt>Released</dt>
          <dd>{fmt(data.date)}</dd>
        </div>
        {data.recorded_date && (
          <div>
            <dt>Recorded</dt>
            <dd>{fmt(data.recorded_date)}</dd>
          </div>
        )}
        {data.series && (
          <div>
            <dt>Series</dt>
            <dd>{data.series}</dd>
          </div>
        )}
        {data.duration && (
          <div>
            <dt>Duration</dt>
            <dd>{data.duration}</dd>
          </div>
        )}
      </dl>
    </header>

    {data.format === 'summon' && <EpisodeDisclosure continueUrl={data.summon_url} />}

    <EpisodeMedia title={displayTitle} audioUrl={data.audio_url} youtube={data.youtube} />

    {data.signature_quote && (
      <blockquote class="episode-quote">
        <p>“{data.signature_quote}”</p>
        {data.quote_attribution && <cite>{data.quote_attribution}</cite>}
      </blockquote>
    )}

    <div class="prose episode-notes">
      <Content />
    </div>

    {data.chapters?.length && (
      <EpisodeChapters chapters={data.chapters} verified={data.chapters_verified} />
    )}

    {data.sources?.length && <EpisodeSources sources={data.sources} />}

    {data.transcript_url && (
      <p class="episode-transcript"><a href={data.transcript_url}>Read the transcript</a></p>
    )}

    <nav class="episode-adjacent" aria-label="Episode navigation">
      {previous ? (
        <a href={'/podcast/' + previous.slug + '/'}>
          <span>Previous</span>
          {episodeDisplayTitle(previous.data)}
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a href={'/podcast/' + next.slug + '/'}>
          <span>Next</span>
          {episodeDisplayTitle(next.data)}
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </article>
</Base>
