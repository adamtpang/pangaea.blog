---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Titles only, newest first. The index is a list of links and nothing
// else, the way paulgraham.com/articles.html is: no dates, no blurbs, no
// thumbnails, no search, no sort, no tags, no cadence counter, no script.
// Everything about an essay lives on the essay's own page.
const epoch = new Date('1971-01-01').valueOf();
const posts = (
  await getCollection('posts', ({ data }) => !data.draft && data.date.valueOf() >= epoch)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Essays | Pangaea" description="Essays across time, by Adam Pang.">
  <p class="section-kicker">Read</p>
  <h1>Essays</h1>

  {posts.length === 0 && <p class="meta">No essays are public yet.</p>}

  {posts.length > 0 && (
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={`/posts/${p.slug}/`}>
            <span class="title">{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
