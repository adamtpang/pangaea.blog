---
import Base from '../layouts/Base.astro';

/*
  /daily — the writing surface. Formerly 300words.app, now part of Pangaea.

  Speak or type 300 words a day. The page is local-first: everything lives in
  localStorage on this device and nothing is sent anywhere until you choose to
  send it. "Send to /write" hands the day's page to the backstage editor as a
  seedling draft, which is the front of the capture -> scaffold -> ship pipeline.

  Pairs with Handy (handy.computer) for system-wide dictation: click into the
  page, hold the hotkey, talk. No integration needed, it just types. The mic
  button is the in-browser fallback (Chrome / Edge).
*/
---

<Base
  title="Daily · Pangaea"
  description="Write 300 words a day. Speak them or type them. The daily page that feeds the essays."
>
  <div class="daily">
    <p class="backline" id="backline">
      <span id="backlineText">Viewing an older page, read only.</span>
      <button type="button" id="backBtn">&larr; Back to today</button>
    </p>

    <div class="seedbar" id="seedbar" hidden>
      <div class="seedbar-head">
        <span class="seedbar-label">Today's prompts</span>
        <button type="button" class="linkbtn" id="seedShuffle">shuffle</button>
        <button type="button" class="linkbtn" id="seedClear">write freely</button>
      </div>
      <div class="seedchips" id="seedchips"></div>
      <p class="seedactive" id="seedActive" hidden></p>
    </div>

    <div class="sheet">
      <div class="sheet-head">
        <span class="sheet-date" id="dateLabel">Today</span>
        <span class="sheet-streak" id="streak"><i aria-hidden="true">&#9670;</i> <span id="streakText">start your streak today</span></span>
      </div>

      <textarea
        id="page"
        spellcheck="true"
        autocomplete="off"
        aria-label="Today's page, write or dictate here"
        placeholder="Start talking, or typing. Whatever is in your head counts."></textarea>

      <div class="sheet-foot">
        <div class="meter">
          <span><b id="wc">0</b> / 300 words</span>
          <span id="wcState">say it or type it, it all counts</span>
        </div>
        <div class="bar-track"><div class="bar-fill" id="fill"></div></div>
      </div>

      <div class="stamp" id="stamp" aria-hidden="true">
        <span class="stamp-big">300</span><small>Done</small>
      </div>
    </div>

    <div class="actions">
      <button type="button" class="btn" id="sendBtn">Send to /write &rarr;</button>
      <a href="#" class="linkbtn" id="sendRawLink" hidden>send raw instead</a>
      <button type="button" class="btn ghost" id="polishBtn" hidden>Polish into an essay &#10022;</button>
      <button type="button" class="btn ghost" id="micBtn" aria-pressed="false">
        <span class="recdot" aria-hidden="true"></span><span id="micLabel">Speak</span>
      </button>
      <button type="button" class="btn ghost" id="copyBtn"><span id="copyLabel">Copy</span></button>
      <button type="button" class="btn ghost" id="dlBtn">.md</button>
      <p id="statusLine"><span id="status" role="status"></span> <span id="interim"></span></p>
    </div>

    <div class="polish" id="polishPanel" hidden>
      <div class="polish-head">
        <span class="polish-label">Polished draft</span>
        <button type="button" class="linkbtn" id="polishDiscard">discard</button>
      </div>
      <p class="polish-title" id="polishTitle"></p>
      <p class="polish-blurb" id="polishBlurb"></p>
      <div class="polish-body" id="polishBody"></div>
    </div>

    <div class="syncbar">
      <span class="sync-dot" id="syncDot" aria-hidden="true"></span>
      <span id="syncState" role="status">Saved on this device only.</span>
      <a class="linkbtn" id="signinBtn" href="/api/auth/github" hidden>Sign in with GitHub</a>
      <button type="button" class="linkbtn" id="signoutBtn" hidden>Sign out</button>
      <button type="button" class="linkbtn" id="syncBtn" hidden>Use a passphrase instead</button>
    </div>

    <div class="unlock" id="unlock">
      <label for="syncKey">Sync passphrase (kept on this device):</label>
      <input type="password" id="syncKey" autocomplete="current-password" />
      <button type="button" class="btn ghost" id="unlockSave">Unlock</button>
      <button type="button" class="linkbtn" id="unlockCancel">Cancel</button>
    </div>

    <p class="tip">
      Prefer to speak? Click into the page and use
      <a href="https://handy.computer" rel="noopener" target="_blank">Handy</a>, or the
      mic button. When the page is ready, <strong>Send to /write</strong> carries it
      into the editor as a seedling draft to title, trim, and publish.
    </p>

    <p class="warn" id="storageWarn">
      Autosave is not available in this browser session (private mode?). Your words
      will be lost when you close the tab, so copy them out before you go.
    </p>

    <section class="history" aria-labelledby="hist-h">
      <h2 id="hist-h">The last 30 days</h2>
      <div class="stats">
        <div class="stat"><span class="n" id="statTotal">0</span><small>words written</small></div>
        <div class="stat"><span class="n" id="statPages">0</span><small>pages done</small></div>
        <div class="stat"><span class="n" id="statBest">0</span><small>best streak</small></div>
      </div>
      <div class="hgrid" id="hgrid" aria-label="Word counts for the last 30 days"></div>
      <div class="hlegend"><span id="legendStart"></span><span>today</span></div>
      <div class="history-foot">
        <button type="button" class="linkbtn" id="backupBtn">Back up everything (.json)</button>
        <button type="button" class="linkbtn" id="restoreBtn">Restore from backup</button>
        <input type="file" id="restoreInput" accept="application/json,.json" hidden />
        <span class="whisper">Your words stay on this device.</span>
      </div>
    </section>
  </div>
</Base>

<style>
  .daily { max-width: 42rem; }

  /* --- seed prompts -------------------------------------------------- */
  .seedbar {
    margin-bottom: 1rem;
    padding: 0.7rem 0.9rem 0.8rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .seedbar-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.55rem;
  }
  .seedbar-label {
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 560;
    color: var(--ink-soft);
  }
  .seedchips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .seedchip {
    font: inherit;
    font-size: 0.86rem;
    text-align: left;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.4em 0.7em;
    color: var(--ink-soft);
    cursor: pointer;
    max-width: 100%;
  }
  .seedchip:hover { border-color: var(--accent); color: var(--ink); }
  .seedchip.active { border-color: var(--accent); background: var(--accent-tint); color: var(--ink); }
  .seedactive {
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    font-style: italic;
    color: var(--ink-mute);
    line-height: 1.5;
  }

  /* --- the sheet --------------------------------------------------- */
  .sheet {
    position: relative;
    background: linear-gradient(180deg, #fff, #fcf9f2);
    border: 1px solid var(--rule);
    border-radius: 4px;
    box-shadow: 0 1px 0 rgba(28, 25, 23, 0.04), 0 18px 40px -24px rgba(28, 25, 23, 0.28);
    padding: 1.4rem 1.4rem 1.2rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .sheet::before {
    content: '';
    position: absolute;
    left: 1.3rem;
    right: 1.3rem;
    top: -1px;
    height: 3px;
    background: repeating-linear-gradient(90deg, var(--accent-tint) 0 6px, transparent 6px 13px);
    opacity: 0.55;
  }
  .sheet:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(179, 74, 47, 0.12), 0 18px 40px -24px rgba(28, 25, 23, 0.28);
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule-soft);
    padding-bottom: 0.6rem;
  }
  .sheet-date {
    font-family: var(--display);
    font-weight: 560;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .sheet-streak { font-size: 0.85rem; color: var(--ink-mute); white-space: nowrap; }
  .sheet-streak i { color: var(--gold); font-style: normal; }
  .sheet-streak.lit { color: var(--accent); font-weight: 500; }
  .sheet-streak.lit i { color: var(--accent); }

  #page {
    display: block;
    width: 100%;
    min-height: min(44vh, 24rem);
    border: 0;
    outline: none;
    resize: none;
    background: transparent;
    font-family: var(--serif);
    font-size: 1.08rem;
    line-height: 1.78;
    font-weight: 380;
    color: var(--ink);
    padding: 0.8rem 0 0.4rem;
    caret-color: var(--accent);
  }
  #page::placeholder { color: var(--ink-mute); opacity: 0.75; font-style: italic; }
  #page[readonly] { color: var(--ink-soft); }

  .sheet-foot { margin-top: 0.5rem; padding-top: 0.8rem; border-top: 1px solid var(--rule-soft); }
  .meter {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--ink-mute);
    margin-bottom: 0.5rem;
  }
  .meter b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .goalhit { color: var(--accent) !important; font-weight: 600; }
  .bar-track {
    height: 6px;
    background: var(--paper-3);
    border: 1px solid var(--rule-soft);
    border-radius: 99px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-deep));
    border-radius: 99px;
    transition: width 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .stamp {
    position: absolute;
    right: -0.5rem;
    bottom: -0.8rem;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    display: grid;
    place-items: center;
    text-align: center;
    font-family: var(--display);
    font-weight: 600;
    line-height: 1;
    background: var(--paper);
    transform: rotate(-9deg);
    opacity: 0;
    pointer-events: none;
  }
  .stamp.show { animation: stampIn 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) forwards; }
  @keyframes stampIn {
    from { opacity: 0; transform: rotate(-9deg) scale(1.5); }
    to { opacity: 0.92; transform: rotate(-9deg) scale(1); }
  }
  .stamp .stamp-big { font-size: 1rem; display: block; }
  .stamp small {
    display: block;
    font-family: var(--serif);
    font-size: 0.5rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: 0.15em;
  }

  /* --- actions ----------------------------------------------------- */
  .actions { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 1.3rem; }
  .actions .btn { font-family: var(--serif); }
  .recdot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
    margin-right: 0.45em;
  }
  #micBtn[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent-deep);
    color: #fff;
  }
  #micBtn[aria-pressed='true'] .recdot { animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  #statusLine {
    width: 100%;
    font-size: 0.88rem;
    color: var(--ink-mute);
    font-style: italic;
    min-height: 1.3em;
    margin: 0.35rem 0 0;
  }
  .heard { color: var(--ink-soft); }

  /* --- polish ---------------------------------------------------------- */
  .polish {
    margin-top: 1rem;
    padding: 1rem 1.1rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--accent-tint);
    border-radius: 3px;
  }
  .polish-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule-soft);
  }
  .polish-label {
    font-family: var(--display);
    font-size: 0.86rem;
    font-weight: 560;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .polish-title {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 560;
    letter-spacing: -0.015em;
    margin: 0 0 0.3rem;
  }
  .polish-blurb {
    font-style: italic;
    color: var(--ink-mute);
    font-size: 0.95rem;
    margin: 0 0 0.8rem;
  }
  .polish-body {
    font-family: var(--serif);
    font-size: 1rem;
    line-height: 1.72;
    color: var(--ink-soft);
    white-space: pre-wrap;
  }

  .backline {
    display: none;
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: var(--ink-mute);
    font-style: italic;
    align-items: center;
    gap: 0.8em;
    flex-wrap: wrap;
  }
  .backline.show { display: flex; }
  .backline button {
    font: inherit;
    font-style: normal;
    color: var(--accent);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--accent-tint);
    cursor: pointer;
    padding: 0;
  }
  .backline button:hover { border-color: var(--accent); }

  /* --- sync ---------------------------------------------------------- */
  .syncbar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    font-size: 0.86rem;
    color: var(--ink-mute);
  }
  .sync-dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: var(--rule);
    flex: none;
  }
  .sync-dot.on { background: var(--gold); }
  .sync-dot.busy { background: var(--accent-tint); }
  .sync-dot.err { background: var(--accent); }

  .unlock {
    display: none;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.7rem;
    padding: 0.8rem 1rem;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 3px;
  }
  .unlock.show { display: flex; }
  .unlock label { width: 100%; font-size: 0.84rem; color: var(--ink-mute); }
  .unlock input {
    font: inherit;
    font-size: 0.92rem;
    flex: 1;
    min-width: 12rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.45em 0.7em;
    color: var(--ink);
  }
  .unlock input:focus { outline: none; border-color: var(--accent); }

  .tip {
    margin-top: 1.2rem;
    font-size: 0.9rem;
    color: var(--ink-mute);
    border-left: 3px solid var(--accent-tint);
    padding: 0.15rem 0 0.15rem 1rem;
    font-style: italic;
  }
  .warn {
    display: none;
    margin-top: 1rem;
    font-size: 0.88rem;
    color: var(--accent-deep);
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.6rem 0.9rem;
  }
  .warn.show { display: block; }

  /* --- history ----------------------------------------------------- */
  .history { margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--rule); }
  .stats { display: flex; gap: 2rem; flex-wrap: wrap; margin-top: 0.8rem; }
  .stat .n {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.5rem;
    display: block;
    letter-spacing: -0.02em;
  }
  .stat small {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .hgrid { display: flex; align-items: flex-end; gap: 4px; margin-top: 1.3rem; height: 64px; }
  .hbar {
    flex: 1;
    min-width: 4px;
    max-width: 22px;
    background: var(--paper-3);
    border: 1px solid var(--rule-soft);
    border-radius: 2px 2px 0 0;
    padding: 0;
    align-self: flex-end;
    transition: background-color 0.25s;
  }
  .hbar.filled { background: var(--accent-tint); border-color: var(--accent-tint); }
  .hbar.done { background: var(--accent); border-color: var(--accent-deep); }
  .hbar.today { box-shadow: 0 0 0 2px var(--paper), 0 0 0 3.5px var(--accent); }
  .hbar[data-view] { cursor: pointer; }
  .hbar[data-view]:hover { background: var(--accent-deep); }
  .hlegend {
    display: flex;
    justify-content: space-between;
    font-size: 0.76rem;
    color: var(--ink-mute);
    margin-top: 0.4rem;
  }
  .history-foot {
    margin-top: 1.5rem;
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .linkbtn {
    font: inherit;
    font-size: 0.86rem;
    color: var(--ink-mute);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--rule);
    padding: 0 0 0.05em;
    cursor: pointer;
  }
  .linkbtn:hover { color: var(--accent); border-color: var(--accent); }
  .whisper { font-size: 0.84rem; color: var(--ink-mute); font-style: italic; }

  @media (prefers-reduced-motion: reduce) {
    .stamp.show { animation: none; opacity: 0.92; }
    #micBtn[aria-pressed='true'] .recdot { animation: none; }
    .bar-fill { transition: none; }
  }
  @media (max-width: 540px) {
    .stats { gap: 1.25rem; }
    .actions .btn { font-size: 0.82rem; }
  }
</style>

<script is:inline>
  (function () {
    'use strict';

    var GOAL = 300;
    var KEY = 'w300.entries.v1';
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var page = document.getElementById('page');
    var wc = document.getElementById('wc');
    var wcState = document.getElementById('wcState');
    var fill = document.getElementById('fill');
    var stamp = document.getElementById('stamp');
    var statusEl = document.getElementById('status');
    var interimEl = document.getElementById('interim');

    function setStatus(html) { statusEl.innerHTML = html || ''; }
    function setInterim(html) { interimEl.innerHTML = html || ''; }

    /* ---------- storage ---------- */
    function loadAll() {
      try {
        var v = JSON.parse(localStorage.getItem(KEY));
        return v && typeof v === 'object' && !Array.isArray(v) ? v : {};
      } catch (e) { return {}; }
    }
    function persist() {
      try {
        // Merge onto the freshest stored state so a stale tab never clobbers
        // days written elsewhere. This tab only ever mutates today.
        var latest = loadAll();
        for (var k in entries) {
          if (Object.prototype.hasOwnProperty.call(entries, k) &&
              !Object.prototype.hasOwnProperty.call(latest, k)) {
            latest[k] = entries[k];
          }
        }
        if (entries[todayK]) latest[todayK] = entries[todayK];
        entries = latest;
        localStorage.setItem(KEY, JSON.stringify(entries));
      } catch (e) {
        document.getElementById('storageWarn').classList.add('show');
      }
    }

    /* ---------- dates ---------- */
    function fmtKey(d) {
      return d.getFullYear() + '-' +
        String(d.getMonth() + 1).padStart(2, '0') + '-' +
        String(d.getDate()).padStart(2, '0');
    }
    function keyOffset(n) { var d = new Date(); d.setDate(d.getDate() - n); return fmtKey(d); }
    function keyToDate(k) { var p = k.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }
    function prettyDate(k) {
      return keyToDate(k).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
    }
    function shortDate(k) {
      return keyToDate(k).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }

    var entries = loadAll();
    var todayK = fmtKey(new Date());
    var viewK = todayK;
    var prevWords = 0;

    function countWords(t) { t = t.trim(); return t ? t.split(/\s+/).length : 0; }
    function isDone(k) { var e = entries[k]; return !!(e && e.words >= GOAL); }

    /* ---------- streaks ---------- */
    function currentStreak() {
      var todayDone = isDone(keyOffset(0));
      var s = 0;
      for (var i = todayDone ? 0 : 1; ; i++) {
        if (isDone(keyOffset(i))) s++; else break;
      }
      return { n: s, todayDone: todayDone };
    }
    function bestStreak() {
      var days = Object.keys(entries).filter(isDone).sort();
      var best = 0, run = 0, prev = null;
      for (var i = 0; i < days.length; i++) {
        var k = days[i];
        if (prev && Math.round((keyToDate(k) - keyToDate(prev)) / 86400000) === 1) run++;
        else run = 1;
        if (run > best) best = run;
        prev = k;
      }
      return best;
    }
    function renderStreak() {
      var st = currentStreak();
      var el = document.getElementById('streak');
      var txt = document.getElementById('streakText');
      if (st.n === 0) { el.classList.remove('lit'); txt.textContent = 'start your streak today'; }
      else if (st.todayDone) { el.classList.add('lit'); txt.textContent = st.n + '-day streak'; }
      else { el.classList.remove('lit'); txt.textContent = st.n + '-day streak, write today to keep it'; }
    }

    /* ---------- meter ---------- */
    var lastWords = 0;
    function updateMeter(words) {
      lastWords = words;
      wc.textContent = words;
      fill.style.width = Math.min(100, (words / GOAL) * 100) + '%';
      if (words >= GOAL) {
        wcState.textContent = 'goal reached';
        wcState.className = 'goalhit';
        stamp.classList.add('show');
      } else {
        wcState.textContent = words === 0 ? 'say it or type it, it all counts' : 'keep going...';
        wcState.className = '';
        stamp.classList.remove('show');
      }
      refreshPolishVisibility();
    }

    var saveTimer = null;
    function scheduleSave() {
      if (saveTimer) clearTimeout(saveTimer);
      saveTimer = setTimeout(saveNow, 400);
    }
    function saveNow() {
      if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; }
      if (viewK !== todayK) return; // never write over the archive
      var t = page.value;
      if (!t && !entries[todayK]) return;
      var e = entries[todayK] || (entries[todayK] = {});
      e.text = t; e.words = countWords(t); e.updatedAt = Date.now();
      persist();
      renderStreak();
      renderHistory();
      schedulePush();
    }

    page.addEventListener('input', function () {
      if (viewK !== todayK) return;
      var w = countWords(page.value);
      if (w >= GOAL && prevWords < GOAL) {
        var e = entries[todayK] || (entries[todayK] = {});
        if (!e.doneAt) e.doneAt = Date.now();
      }
      prevWords = w;
      updateMeter(w);
      scheduleSave();
    });

    /* ---------- view (today vs archive) ---------- */
    function renderView() {
      var e = entries[viewK] || {};
      var text = e.text || '';
      var words = e.words || countWords(text);
      var isToday = viewK === todayK;

      document.getElementById('dateLabel').textContent =
        (isToday ? 'Today, ' : '') + prettyDate(viewK);
      page.value = text;
      page.readOnly = !isToday;
      page.setAttribute('aria-label', isToday
        ? "Today's page, write or dictate here"
        : 'Page from ' + prettyDate(viewK) + ', read only');
      prevWords = words;
      updateMeter(words);

      document.getElementById('backline').classList.toggle('show', !isToday);
      if (!isToday) {
        document.getElementById('backlineText').textContent =
          'Viewing ' + prettyDate(viewK) + ', read only.';
      }
      document.getElementById('micBtn').style.display =
        isToday && speechAvailable ? '' : 'none';
      renderPolishForView();
      refreshPolishVisibility();
      if (!isToday) stopListening();
    }
    document.getElementById('backBtn').addEventListener('click', function () {
      viewK = todayK;
      renderView();
      page.focus();
    });

    /* ---------- day rollover ---------- */
    function checkDay() {
      var nk = fmtKey(new Date());
      if (nk !== todayK) {
        saveNow();
        var wasToday = viewK === todayK;
        todayK = nk;
        if (wasToday) { viewK = nk; renderView(); }
        renderStreak();
        renderHistory();
      }
    }
    setInterval(checkDay, 60000);
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') checkDay(); else saveNow();
    });
    window.addEventListener('pagehide', saveNow);

    /* ---------- speech ---------- */
    var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    var speechAvailable = !!SR;
    var rec = null, wantListening = false, restartTimer = null, restartCount = 0;
    var micBtn = document.getElementById('micBtn');
    var micLabel = document.getElementById('micLabel');

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function appendText(t) {
      t = t.trim();
      if (!t) return;
      var v = page.value;
      page.value = v + (v && !/\s$/.test(v) ? ' ' : '') + t;
      page.scrollTop = page.scrollHeight;
      page.dispatchEvent(new Event('input'));
    }
    function updateMicUI(on) {
      micBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      micLabel.textContent = on ? 'Stop' : 'Speak';
    }
    function startListening() {
      if (!SR || viewK !== todayK) return;
      wantListening = true;
      rec = new SR();
      rec.continuous = true;
      rec.interimResults = true;
      rec.lang = navigator.language || 'en-US';
      rec.onresult = function (ev) {
        var interim = '';
        for (var i = ev.resultIndex; i < ev.results.length; i++) {
          var r = ev.results[i];
          if (r.isFinal) { appendText(r[0].transcript); restartCount = 0; }
          else interim += r[0].transcript;
        }
        // Interim goes to a non-live span so screen readers are not spammed.
        setInterim(interim
          ? 'hearing: <span class="heard">...' + escapeHtml(interim.slice(-70)) + '</span>'
          : '');
      };
      rec.onend = function () {
        // Resume only if still wanted, re-checking the flag AT FIRE TIME, and
        // cap retries so an unrecoverable error cannot loop forever.
        if (!wantListening) { updateMicUI(false); return; }
        if (++restartCount > 12) {
          wantListening = false;
          updateMicUI(false);
          setStatus('Dictation paused. Click Speak to pick up where you left off.');
          return;
        }
        restartTimer = setTimeout(function () {
          restartTimer = null;
          if (wantListening) { try { rec.start(); } catch (e) {} }
        }, Math.min(250 * restartCount, 2000));
      };
      rec.onerror = function (ev) {
        var err = ev.error;
        if (err === 'not-allowed' || err === 'service-not-allowed') {
          wantListening = false;
          if (document.activeElement === micBtn) page.focus();
          updateMicUI(false);
          micBtn.disabled = true;
          setStatus('Mic blocked by the browser. Handy still works: click into the page and speak.');
        } else if (err === 'network') {
          wantListening = false; updateMicUI(false);
          setStatus('Dictation needs a connection. Check your internet, then Speak again.');
        } else if (err === 'audio-capture') {
          wantListening = false; updateMicUI(false);
          setStatus('No microphone found. Plug one in (or use Handy), then Speak again.');
        } else if (err === 'no-speech') {
          setInterim('listening... (say something)');
        }
      };
      try {
        rec.start();
        updateMicUI(true);
        setStatus('listening...');
        page.focus();
      } catch (e) {
        wantListening = false;
        updateMicUI(false);
        setStatus("Could not start dictation just now. Try again, or use Handy.");
      }
    }
    function stopListening() {
      wantListening = false;
      if (restartTimer) { clearTimeout(restartTimer); restartTimer = null; }
      if (rec) { try { rec.stop(); } catch (e) {} }
      updateMicUI(false);
      setStatus('');
      setInterim('');
    }
    micBtn.addEventListener('click', function () {
      if (micBtn.getAttribute('aria-pressed') === 'true') stopListening();
      else startListening();
    });
    if (!speechAvailable) {
      micBtn.style.display = 'none';
      setStatus('Built-in dictation needs Chrome or Edge. Handy works everywhere.');
    }

    /* ---------- export ---------- */
    function currentText() {
      var e = entries[viewK] || {};
      return (viewK === todayK ? page.value : e.text || '').trim();
    }
    function asMarkdown() {
      return '# ' + prettyDate(viewK) + ', ' + keyToDate(viewK).getFullYear() +
        '\n\n' + currentText() + '\n';
    }
    document.getElementById('copyBtn').addEventListener('click', function () {
      if (!currentText()) { setStatus('Nothing to copy yet, the page is blank.'); return; }
      var label = document.getElementById('copyLabel');
      var ok = function () {
        label.textContent = 'Copied';
        setTimeout(function () { label.textContent = 'Copy'; }, 1800);
      };
      var md = asMarkdown();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(md).then(ok, function () { fallbackCopy(md, ok); });
      } else fallbackCopy(md, ok);
    });
    function fallbackCopy(text, ok) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); ok(); }
      catch (e) { setStatus('Copy failed, select the text and copy manually.'); }
      document.body.removeChild(ta);
    }
    function downloadFile(name, content, type) {
      var blob = new Blob([content], { type: type + ';charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
    }
    document.getElementById('dlBtn').addEventListener('click', function () {
      if (!currentText()) { setStatus('Nothing to download yet, the page is blank.'); return; }
      downloadFile('300words-' + viewK + '.md', asMarkdown(), 'text/markdown');
    });
    document.getElementById('backupBtn').addEventListener('click', function () {
      saveNow();
      downloadFile('300words-backup-' + todayK + '.json', JSON.stringify(entries, null, 2), 'application/json');
    });

    /* Restore: the standalone app lived on another origin, so its localStorage
       does not follow you here. This imports a backup and merges it in. */
    var restoreInput = document.getElementById('restoreInput');
    document.getElementById('restoreBtn').addEventListener('click', function () {
      restoreInput.click();
    });
    restoreInput.addEventListener('change', function () {
      var file = restoreInput.files && restoreInput.files[0];
      if (!file) return;
      var fr = new FileReader();
      fr.onload = function () {
        var incoming;
        try { incoming = JSON.parse(String(fr.result)); }
        catch (e) { setStatus('That file is not valid JSON.'); return; }
        if (!incoming || typeof incoming !== 'object' || Array.isArray(incoming)) {
          setStatus('That does not look like a 300words backup.');
          return;
        }
        var added = 0;
        for (var k in incoming) {
          if (!Object.prototype.hasOwnProperty.call(incoming, k)) continue;
          if (!/^\d{4}-\d{2}-\d{2}$/.test(k)) continue;
          var inc = incoming[k];
          if (!inc || typeof inc.text !== 'string') continue;
          var cur = entries[k];
          // Keep whichever version has more writing; never silently shrink a day.
          if (!cur || (inc.words || 0) > (cur.words || 0)) {
            entries[k] = { text: inc.text, words: inc.words || 0, updatedAt: inc.updatedAt || Date.now() };
            added++;
          }
        }
        persist();
        renderView(); renderStreak(); renderHistory();
        setStatus(added ? 'Restored ' + added + ' day' + (added === 1 ? '' : 's') + '.' : 'Nothing new to restore.');
        restoreInput.value = '';
      };
      fr.readAsText(file);
    });

    /* ---------- send to /write ---------- */
    function sendToWrite(useRaw) {
      var polished = !useRaw && polishMap[viewK];
      var text, title;
      if (polished) {
        text = polished.body;
        title = polished.title;
      } else {
        text = currentText();
        if (!text) { setStatus('Nothing to send yet, write your page first.'); return; }
        var first = (text.split(/\n/)[0] || '').trim();
        title = (first.split(/[.!?]/)[0] || first).split(/\s+/).slice(0, 9).join(' ');
      }
      saveNow();
      // Same origin now, so a plain navigation works: no popup, nothing blocked.
      window.location.href = '/write?from=daily&title=' +
        encodeURIComponent(title) + '&seed=' + encodeURIComponent(text);
    }
    document.getElementById('sendBtn').addEventListener('click', function () { sendToWrite(false); });
    document.getElementById('sendRawLink').addEventListener('click', function (ev) {
      ev.preventDefault();
      sendToWrite(true);
    });

    /* ---------- polish: AI-edit today's words into a mini essay ----------
       Never automatic. Only runs when Adam taps the button, and only once
       there is something worth polishing. The raw page is always what gets
       saved locally; polish is a derived, disposable artifact kept in its
       own localStorage key so it is never sent through /api/daily/sync. */
    var POLISH_KEY = 'w300.polish.v1';
    function loadPolishMap() {
      try {
        var v = JSON.parse(localStorage.getItem(POLISH_KEY));
        return v && typeof v === 'object' && !Array.isArray(v) ? v : {};
      } catch (e) { return {}; }
    }
    function savePolishMap() {
      try { localStorage.setItem(POLISH_KEY, JSON.stringify(polishMap)); } catch (e) {}
    }
    var polishMap = loadPolishMap();

    var polishBtn = document.getElementById('polishBtn');
    var polishPanel = document.getElementById('polishPanel');
    var polishTitleEl = document.getElementById('polishTitle');
    var polishBlurbEl = document.getElementById('polishBlurb');
    var polishBodyEl = document.getElementById('polishBody');
    var sendBtnEl = document.getElementById('sendBtn');
    var sendRawLinkEl = document.getElementById('sendRawLink');

    function refreshPolishVisibility() {
      // Polish costs a real API call, so only offer it once there is enough
      // to work with, and only when sync/auth confirms the endpoint can
      // actually authorize the request (it is gated the same way as sync).
      polishBtn.hidden = !(typeof syncOn === 'function' && syncOn() && lastWords >= GOAL);
    }

    function renderPolishForView() {
      var p = polishMap[viewK];
      var isToday = viewK === todayK;
      if (p) {
        polishPanel.hidden = false;
        polishTitleEl.textContent = p.title;
        polishBlurbEl.textContent = p.blurb;
        polishBodyEl.textContent = p.body;
        sendBtnEl.textContent = 'Send polished essay to /write →';
        sendRawLinkEl.hidden = false;
      } else {
        polishPanel.hidden = true;
        sendBtnEl.textContent = isToday ? 'Send to /write →' : 'Send this page to /write →';
        sendRawLinkEl.hidden = true;
      }
    }

    polishBtn.addEventListener('click', function () {
      var t = currentText();
      if (!t) { setStatus('Nothing to polish yet, write your page first.'); return; }
      polishBtn.disabled = true;
      setStatus('Polishing…');
      var headers = { 'content-type': 'application/json' };
      if (!signedInAs && syncKey) headers['x-daily-key'] = syncKey;
      fetch('/api/daily/polish', {
        method: 'POST',
        headers: headers,
        credentials: 'same-origin',
        body: JSON.stringify({
          text: t,
          seedTitle: activeSeed ? activeSeed.suggestedTitle : undefined,
          seedPrompt: activeSeed ? activeSeed.prompt : undefined
        })
      })
        .then(function (r) { return r.json().then(function (d) { return { status: r.status, d: d }; }); })
        .then(function (res) {
          polishBtn.disabled = false;
          if (res.status !== 200) {
            setStatus((res.d && res.d.error) || 'Polish failed. Your words are still saved.');
            return;
          }
          polishMap[viewK] = {
            title: res.d.title,
            blurb: res.d.blurb,
            body: res.d.body,
            tags: res.d.tags || [],
            seedId: activeSeed ? activeSeed.id : null,
            at: Date.now()
          };
          savePolishMap();
          renderPolishForView();
          setStatus('Polished. Review it, then Send to /write.');
        })
        .catch(function () {
          polishBtn.disabled = false;
          setStatus('Could not reach the polish endpoint. Your raw words are safe.');
        });
    });

    document.getElementById('polishDiscard').addEventListener('click', function () {
      delete polishMap[viewK];
      savePolishMap();
      renderPolishForView();
    });

    /* ---------- seed prompts ----------
       Gated the same way as sync: some of these come from private notes, so
       an anonymous visitor to /daily gets no seed bar at all, never a
       redacted one. "Shuffle" just bumps a round counter and re-derives a
       different deterministic pick; no server state to keep in sync. */
    var seedbar = document.getElementById('seedbar');
    var seedchips = document.getElementById('seedchips');
    var seedActiveEl = document.getElementById('seedActive');
    var SEED_ROUND_KEY = 'w300.seedRound';
    var activeSeed = null;

    function seedRound() {
      try { return parseInt(localStorage.getItem(SEED_ROUND_KEY), 10) || 0; } catch (e) { return 0; }
    }
    function bumpSeedRound() {
      try { localStorage.setItem(SEED_ROUND_KEY, String(seedRound() + 1)); } catch (e) {}
    }

    function setActiveSeed(seed, chipEl) {
      activeSeed = seed;
      if (seed) {
        seedActiveEl.hidden = false;
        seedActiveEl.textContent = seed.prompt;
      } else {
        seedActiveEl.hidden = true;
      }
      Array.prototype.forEach.call(seedchips.children, function (c) { c.classList.remove('active'); });
      if (chipEl) chipEl.classList.add('active');
    }

    function renderSeedChips(seeds) {
      seedchips.innerHTML = '';
      seeds.forEach(function (s) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'seedchip';
        b.textContent = s.suggestedTitle || (s.prompt.length > 42 ? s.prompt.slice(0, 42) + '…' : s.prompt);
        b.title = s.prompt;
        b.addEventListener('click', function () {
          setActiveSeed(s, b);
          if (viewK === todayK) page.focus();
        });
        seedchips.appendChild(b);
      });
    }

    function loadSeeds() {
      if (typeof syncOn !== 'function' || !syncOn()) { seedbar.hidden = true; return; }
      var headers = {};
      if (!signedInAs && syncKey) headers['x-daily-key'] = syncKey;
      fetch('/api/daily/seeds?date=' + encodeURIComponent(todayK) + '&round=' + seedRound(), {
        credentials: 'same-origin',
        headers: headers
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) {
          if (!d || !d.seeds || !d.seeds.length) { seedbar.hidden = true; return; }
          seedbar.hidden = false;
          renderSeedChips(d.seeds);
        })
        .catch(function () { seedbar.hidden = true; });
    }

    document.getElementById('seedShuffle').addEventListener('click', function () {
      bumpSeedRound();
      setActiveSeed(null, null);
      loadSeeds();
    });
    document.getElementById('seedClear').addEventListener('click', function () {
      setActiveSeed(null, null);
    });

    /* ---------- history ---------- */
    var DAYS = 30;
    function renderHistory() {
      var grid = document.getElementById('hgrid');
      grid.innerHTML = '';
      for (var i = DAYS - 1; i >= 0; i--) {
        var k = keyOffset(i);
        var e = entries[k];
        var words = e ? e.words || 0 : 0;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'hbar' +
          (words >= GOAL ? ' done' : words > 0 ? ' filled' : '') +
          (k === todayK ? ' today' : '');
        b.style.height = (words > 0 ? Math.max(8, Math.round(60 * Math.min(words, GOAL) / GOAL)) : 4) + 'px';
        b.setAttribute('aria-label', shortDate(k) + ', ' + words + ' words' + (words >= GOAL ? ', done' : ''));
        b.title = shortDate(k) + ', ' + words + ' words';
        if (e && e.text) {
          b.setAttribute('data-view', k);
          b.addEventListener('click', function (ev) {
            saveNow();
            viewK = ev.currentTarget.getAttribute('data-view');
            renderView();
            // Focus the sheet: announces the change, and survives the grid
            // being rebuilt by the saveNow above.
            page.focus();
            window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          });
        } else {
          b.disabled = true;
        }
        grid.appendChild(b);
      }
      document.getElementById('legendStart').textContent = shortDate(keyOffset(DAYS - 1));

      var total = 0, pages = 0;
      for (var k2 in entries) {
        if (!Object.prototype.hasOwnProperty.call(entries, k2)) continue;
        total += entries[k2].words || 0;
        if ((entries[k2].words || 0) >= GOAL) pages++;
      }
      document.getElementById('statTotal').textContent = total.toLocaleString('en-US');
      document.getElementById('statPages').textContent = pages;
      document.getElementById('statBest').textContent = bestStreak();
    }

    /* ---------- sync (optional, passphrase-gated) ----------
       Local-first stays true: the server is a backup and a cross-device
       merge, never the source of truth. If sync is off, or the network is
       down, the page still saves to this device exactly as before. */
    var KEYSTORE = 'w300.key';
    var syncKey = null;
    var pushTimer = null;
    var lastSyncAt = 0;
    var syncDot = document.getElementById('syncDot');
    var syncState = document.getElementById('syncState');
    var syncBtn = document.getElementById('syncBtn');
    var unlockBox = document.getElementById('unlock');
    var keyInput = document.getElementById('syncKey');

    function readKey() {
      try { return localStorage.getItem(KEYSTORE) || null; } catch (e) { return null; }
    }
    function writeKey(v) {
      try {
        if (v) localStorage.setItem(KEYSTORE, v);
        else localStorage.removeItem(KEYSTORE);
      } catch (e) {}
      syncKey = v;
    }
    function setSync(state, msg) {
      syncDot.className = 'sync-dot' + (state ? ' ' + state : '');
      syncState.textContent = msg;
    }
    function ago(ts) {
      var s = Math.round((Date.now() - ts) / 1000);
      if (s < 45) return 'just now';
      if (s < 5400) return Math.round(s / 60) + 'm ago';
      return Math.round(s / 3600) + 'h ago';
    }
    /* Signed in with GitHub? Then the session cookie authorizes sync and there
       is no passphrase to think about. The passphrase route stays as a fallback
       for deployments where OAuth is not configured. */
    var signedInAs = null;
    var canOauth = false;
    var canPassphrase = false;
    var signinBtn = document.getElementById('signinBtn');
    var signoutBtn = document.getElementById('signoutBtn');

    function syncOn() { return !!(signedInAs || syncKey); }

    function refreshSyncUI() {
      signinBtn.hidden = true;
      signoutBtn.hidden = true;
      syncBtn.hidden = true;

      if (signedInAs) {
        signoutBtn.hidden = false;
        setSync('on', lastSyncAt
          ? 'Synced ' + ago(lastSyncAt) + ', as ' + signedInAs + '.'
          : 'Signed in as ' + signedInAs + '. Your pages follow you.');
        return;
      }
      if (syncKey) {
        syncBtn.hidden = false;
        syncBtn.textContent = 'Turn off';
        setSync('on', lastSyncAt ? 'Synced ' + ago(lastSyncAt) + '.' : 'Sync is on.');
        return;
      }
      if (canOauth) {
        signinBtn.hidden = false;
        if (canPassphrase) { syncBtn.hidden = false; syncBtn.textContent = 'Use a passphrase instead'; }
        setSync('', 'Saved on this device only. Sign in to keep it across devices.');
        return;
      }
      if (canPassphrase) {
        syncBtn.hidden = false;
        syncBtn.textContent = 'Turn on sync';
        setSync('', 'Saved on this device only.');
        return;
      }
      setSync('', 'Saved on this device only.');
    }

    /* One POST does both directions: the server merges what it has with what
       we send and returns the union, so this is also the "pull". */
    function pushNow(opts) {
      if (!syncOn()) return;
      if (pushTimer) { clearTimeout(pushTimer); pushTimer = null; }
      setSync('busy', 'Syncing...');
      var headers = { 'content-type': 'application/json' };
      // Signed in? The session cookie carries the authorization instead.
      if (!signedInAs && syncKey) headers['x-daily-key'] = syncKey;
      fetch('/api/daily/sync', {
        method: 'POST',
        headers: headers,
        credentials: 'same-origin',
        body: JSON.stringify({ entries: entries }),
        keepalive: !!(opts && opts.keepalive)
      })
        .then(function (r) {
          return r.json().catch(function () { return {}; })
            .then(function (d) { return { status: r.status, ok: r.ok, d: d }; });
        })
        .then(function (res) {
          if (res.status === 401) {
            var wasSignedIn = !!signedInAs;
            signedInAs = null;
            writeKey(null);
            refreshSyncUI();
            setSync('err', wasSignedIn
              ? 'Your session expired. Sign in again to keep syncing.'
              : 'That passphrase was rejected. Turn sync on again.');
            return;
          }
          if (res.status === 503) {
            setSync('err', (res.d && res.d.error) || 'Sync is not set up on the server yet.');
            return;
          }
          if (!res.ok) {
            setSync('err', 'Sync failed. Your writing is still saved on this device.');
            return;
          }
          if (res.d && res.d.entries) mergeRemote(res.d.entries);
          lastSyncAt = Date.now();
          setSync('on', 'Synced just now.');
        })
        .catch(function () {
          setSync('err', 'Offline. Saved on this device, will sync when you are back.');
        });
    }
    function schedulePush() {
      if (!syncOn()) return;
      if (pushTimer) clearTimeout(pushTimer);
      // Slow on purpose: a commit per burst of writing, not per keystroke.
      pushTimer = setTimeout(function () { pushTimer = null; pushNow(); }, 6000);
    }
    /* Same never-shrink rule the server uses, so both sides agree. */
    function mergeRemote(remote) {
      var changed = 0;
      for (var k in remote) {
        if (!Object.prototype.hasOwnProperty.call(remote, k)) continue;
        var inc = remote[k], cur = entries[k];
        if (!cur || inc.words > cur.words ||
            (inc.words === cur.words && (inc.updatedAt || 0) > (cur.updatedAt || 0))) {
          // Do not yank text out from under the cursor mid-sentence.
          if (k === todayK && viewK === todayK && document.activeElement === page &&
              (cur && cur.words) >= inc.words) continue;
          entries[k] = inc;
          changed++;
        }
      }
      if (changed) {
        persist();
        if (document.activeElement !== page) renderView();
        renderStreak();
        renderHistory();
      }
      return changed;
    }

    syncBtn.addEventListener('click', function () {
      if (syncKey) {
        if (!confirm('Turn off sync on this device? Your pages stay saved here, and stay on the server.')) return;
        writeKey(null);
        refreshSyncUI();
        refreshPolishVisibility();
        seedbar.hidden = true;
        return;
      }
      unlockBox.classList.add('show');
      keyInput.focus();
    });
    document.getElementById('unlockCancel').addEventListener('click', function () {
      unlockBox.classList.remove('show');
      keyInput.value = '';
    });
    document.getElementById('unlockSave').addEventListener('click', function () {
      var v = keyInput.value.trim();
      if (!v) { keyInput.focus(); return; }
      writeKey(v);
      keyInput.value = '';
      unlockBox.classList.remove('show');
      refreshSyncUI();
      refreshPolishVisibility();
      pushNow();
      loadSeeds();
    });
    keyInput.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter') { ev.preventDefault(); document.getElementById('unlockSave').click(); }
    });

    signoutBtn.addEventListener('click', function () {
      fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' })
        .catch(function () {})
        .then(function () {
          signedInAs = null;
          refreshSyncUI();
          refreshPolishVisibility();
          seedbar.hidden = true;
          setSync('', 'Signed out. This device keeps its own copy.');
        });
    });

    // Coming back to the tab is exactly when another device's work should land.
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible' && syncOn()) pushNow();
    });
    window.addEventListener('pagehide', function () {
      if (syncOn() && pushTimer) pushNow({ keepalive: true });
    });

    /* ---------- boot ---------- */
    renderView();
    renderStreak();
    renderHistory();
    syncKey = readKey();
    refreshSyncUI();

    // Ask the server who we are, then start syncing if we are anyone.
    fetch('/api/auth/me', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (me) {
        signedInAs = me.login || null;
        canOauth = !!me.oauth;
        canPassphrase = !!me.passphrase;
        refreshSyncUI();
        refreshPolishVisibility();
        if (syncOn()) { pushNow(); loadSeeds(); }
      })
      .catch(function () { if (syncOn()) { pushNow(); loadSeeds(); } });

    // Surface the result of a GitHub redirect, then tidy the URL.
    (function reportAuthRedirect() {
      var m = new URLSearchParams(location.search).get('auth');
      if (!m) return;
      if (m !== 'ok') {
        var why = {
          'not-allowed': 'That GitHub account is not allowed here.',
          'not-configured': 'GitHub sign-in is not set up on the server yet.',
          'no-session-secret': 'Set SESSION_SECRET (or WRITE_PASSWORD) to enable sessions.',
          'bad-state': 'Sign-in expired. Try again.'
        }[m] || 'Sign-in did not complete. Try again.';
        setSync('err', why);
      }
      history.replaceState({}, '', location.pathname);
    })();

    if (window.matchMedia('(pointer:fine)').matches) page.focus();
  })();
</script>
