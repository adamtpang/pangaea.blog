---
import PilotLayout from '../layouts/PilotLayout.astro';
import { PODCAST_PROMISE } from '../lib/podcast';
import { NEWSLETTER_URL } from '../lib/newsletter';
---

<PilotLayout title="Pangaea" description={PODCAST_PROMISE + ' By Adam Pang.'}>
  <main class="home">
    <span class="earth-mark" role="img" aria-label="Earth">🌍</span>
    <h1 class="wordmark">PANGAEA</h1>
    <p class="promise">An essay, a picture, a song.</p>

    <nav class="entryways" aria-label="Enter Pangaea">
      <a href="/posts/">Read</a>
      <a href="/podcast/">Listen</a>
    </nav>
  </main>

  <footer class="home-footer">
    <a href="/about/">About</a>
    <a href={NEWSLETTER_URL}>Email</a>
    <a href="/rss.xml">RSS</a>
  </footer>
</PilotLayout>

<style>
  .home {
    text-align: center;
    margin-top: 16vh;
  }

  .earth-mark {
    display: block;
    font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji';
    font-size: 3.5rem;
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .wordmark {
    margin: 0 0 0.75rem;
  }

  .promise {
    color: var(--ink-mute);
    font-style: italic;
    margin: 0 0 3rem;
  }

  .entryways {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
  }

  .entryways a {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 520;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .entryways a:hover,
  .entryways a:focus-visible {
    color: var(--accent);
  }

  .home-footer {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 22vh;
    font-size: 0.82rem;
  }

  .home-footer a {
    color: var(--ink-mute);
    text-decoration: none;
  }

  .home-footer a:hover {
    color: var(--accent);
  }
</style>
