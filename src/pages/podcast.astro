---
import Base from '../layouts/Base.astro';
import EpisodeLabel from '../components/podcast/EpisodeLabel.astro';
import { getCollection } from 'astro:content';
import {
  EPISODE_FORMATS,
  FORMAT_META,
  PODCAST_PROMISE,
  PODCAST_TITLE,
} from '../lib/podcast';

const episodes = (await getCollection('episodes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={PODCAST_TITLE + ' | Pangaea'} description={PODCAST_PROMISE}>
  <header class="podcast-intro">
    <p class="section-kicker">Listen</p>
    <h1>{PODCAST_TITLE}</h1>
    <p class="podcast-promise">{PODCAST_PROMISE}</p>
    <p class="podcast-feed-link"><a href="/podcast.xml">Podcast RSS</a></p>
  </header>

  <section class="format-key" aria-labelledby="format-key-title">
    <h2 id="format-key-title">Three forms, one feed</h2>
    <dl>
      {EPISODE_FORMATS.map((format) => (
        <div>
          <dt>{FORMAT_META[format].label}</dt>
          <dd>{FORMAT_META[format].description}</dd>
        </div>
      ))}
    </dl>
  </section>

  {EPISODE_FORMATS.map((format) => {
    const entries = episodes.filter((episode) => episode.data.format === format);
    const meta = FORMAT_META[format];

    return (
      <section class="format-section" aria-labelledby={format + '-title'}>
        <header>
          <h2 id={format + '-title'}>{meta.label}</h2>
          <p>{meta.description}</p>
        </header>

        {entries.length > 0 ? (
          <ol class="episode-list">
            {entries.map((episode) => (
              <li>
                <a href={'/podcast/' + episode.slug + '/'}>
                  <EpisodeLabel
                    format={episode.data.format}
                    number={episode.data.format_number}
                  />
                  <span class="episode-list-title">{episode.data.title}</span>
                  {episode.data.blurb && (
                    <span class="episode-list-blurb">{episode.data.blurb}</span>
                  )}
                  <span class="episode-list-meta">
                    {fmt(episode.data.date)}
                    {episode.data.series && <span> · {episode.data.series}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="format-empty">No {meta.label} episodes are public yet.</p>
        )}
      </section>
    );
  })}
</Base>
