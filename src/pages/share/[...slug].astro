---
import { getCollection, type CollectionEntry } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const epoch = new Date('1971-01-01').valueOf();
  const posts = await getCollection(
    'posts',
    ({ data }) => !data.draft && data.date.valueOf() >= epoch
  );
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080" />
    <title>{data.title} · share</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
    />
    <style is:global>
      /* is:global on purpose: the essay body comes from <Content />, and
         scoped styles never reach it. This page ships no other stylesheet. */
      /* /share v2 — fixed-proportion screenshot essay for X / IG / threads.
         Frame is 1080 × 2160 (canonical 1:2). Take a browser screenshot of the
         framed area and post. */
      /* Synced copy of src/styles/tokens.css ("the daily page"). This page
         is deliberately self-contained so the screenshot frame can be
         designed independently; keep these values in step with tokens.css. */
      :root {
        --paper: #fbf7f0;
        --paper-2: #f5efe4;
        --bg: #fbf7f0;
        --surface: #ffffff;
        --ink: #1c1917;
        --ink-soft: #403a34;
        --muted: #6b625a;
        --rule: #d9cfbe;
        --rule-soft: #e7decf;
        --accent: #2f6b4f;       /* green: interaction */
        --accent-deep: #24533d;
        --accent-soft: #e4eee6;
        --land: #2f6b4f;         /* green: identity */
        --display: 'Fraunces', 'Iowan Old Style', Georgia, serif;
        --serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;
        --sans: var(--serif);
        --mono: 'IBM Plex Mono', 'Menlo', 'Consolas', monospace;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; font-family: var(--serif); }
      body {
        background: #241e1a; /* warm dark surround, so the paper frame glows */
        min-height: 100vh;
      }
      .help {
        max-width: 1080px;
        margin: 24px auto 16px;
        padding: 0 20px;
        font-family: var(--sans);
        font-size: 13px;
        color: #93aaa4;
        text-align: center;
        line-height: 1.5;
      }
      .help a { color: #ffffff; }
      .help code {
        background: rgba(255,255,255,0.08);
        padding: 1px 6px;
        border-radius: 2px;
        font-family: var(--mono);
      }

      /* The frame. Exactly 1080 × 2160, the single-screenshot format
         (screenshotessays.com): mark + title, body, one small footer line.
         Nothing may extend past the frame. The script at the bottom of the
         page sets --fs so the body fills the frame and never overflows;
         everything inside .prose is sized in em so it scales with --fs. */
      .share-frame {
        --fs: 34px;
        width: 1080px;
        height: 2160px;
        margin: 0 auto 40px;
        background: var(--bg);
        color: var(--ink);
        padding: 66px 72px 30px;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.55);
      }
      /* The supercontinent stripe at top. */
      .share-frame::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 10px;
        background: var(--land);
      }

      /* Header: mark + title on one row. */
      .head {
        flex: none;
        display: flex;
        align-items: center;
        gap: 30px;
        margin-bottom: 36px;
      }
      .mark {
        flex: none;
        width: 104px;
        height: 104px;
        border-radius: 22px;
        background: var(--land);
        color: var(--paper);
        font-family: var(--display);
        font-weight: 600;
        font-size: 68px;
        line-height: 104px;
        text-align: center;
      }
      h1.headline {
        font-family: var(--display);
        font-size: 58px;
        line-height: 1.08;
        font-weight: 560;
        letter-spacing: -0.018em;
        margin: 0;
        color: var(--ink);
        text-wrap: balance;
      }

      /* Body prose. Fills the space between header and footer. */
      .prose {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        font-size: var(--fs);
        line-height: 1.36;
      }
      .prose > :first-child { margin-top: 0; }
      .prose > :last-child { margin-bottom: 0; }
      .prose p { margin: 0 0 0.62em; }
      .prose h2, .prose h3 {
        font-family: var(--display);
        font-size: 1.08em;
        font-weight: 600;
        line-height: 1.2;
        margin: 0.9em 0 0.35em;
      }
      .prose ul, .prose ol { margin: 0 0 0.62em; padding-left: 1.15em; }
      .prose li { margin: 0 0 0.2em; }
      .prose a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 0.12em;
      }
      .prose strong { color: var(--ink); font-weight: 700; }
      .prose em { font-style: italic; }
      .prose code { font-family: var(--mono); font-size: 0.86em; }

      .prose blockquote {
        border-left: 5px solid var(--accent-soft);
        padding-left: 0.8em;
        margin: 0.8em 0;
        font-style: italic;
        color: var(--muted);
      }
      .prose .pullquote {
        font-size: 1.15em;
        line-height: 1.3;
        font-style: italic;
        border-left: 6px solid var(--accent);
        padding: 0.3em 0 0.3em 0.8em;
        margin: 0.9em 0;
      }
      .prose .pullquote .attribution {
        display: block;
        font-style: normal;
        font-size: 0.6em;
        color: var(--muted);
        margin-top: 0.5em;
      }
      .prose .pullquote .attribution::before {
        content: '/ ';
        color: var(--accent-soft);
      }

      /* Tables: the quantitative block. White cells, hairline rules, set
         smaller than the body so four columns of numbers fit. */
      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 0.9em 0;
        background: var(--surface);
        font-size: 0.64em;
        line-height: 1.3;
        font-variant-numeric: tabular-nums lining-nums;
      }
      .prose th, .prose td {
        border: 1.5px solid var(--rule);
        padding: 0.5em 0.7em;
        text-align: left;
        vertical-align: top;
      }
      .prose th {
        font-weight: 700;
        color: var(--ink);
        background: var(--accent-soft);
      }
      .prose td[align='right'], .prose th[align='right'] { text-align: right; }
      .prose td[align='center'], .prose th[align='center'] { text-align: center; }

      /* Embeds */
      .prose .embed { margin: 0.9em 0; }
      .prose .embed iframe { width: 100%; border: 0; }
      .prose .embed-yt { aspect-ratio: 16 / 9; }
      .prose .embed-yt iframe { height: 100%; }
      .prose .embed-spotify iframe { height: 152px; border-radius: 12px; }
      .prose .embed-soundcloud iframe { height: 166px; }
      .prose .embed-figure { margin: 0.9em 0; }
      .prose img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
        border-radius: 2px;
      }
      .prose .embed-figure figcaption {
        font-size: 0.6em;
        color: var(--muted);
        text-align: center;
        margin-top: 0.5em;
      }

      /* Optional 3-column key-takeaway grid (Codia-template style).
         Author opt-in via `bullets:` array in post frontmatter. */
      .takeaways {
        flex: none;
        margin: 28px 0 0;
        padding: 26px 30px 20px;
        border: 1px solid var(--rule);
        background: var(--surface);
      }
      .takeaways-label {
        font-size: 14px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--land);
        margin: 0 0 16px;
      }
      .takeaways-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px 28px;
        margin: 0;
        padding: 0;
      }
      .takeaways-grid li {
        list-style: none;
        font-size: 21px;
        line-height: 1.35;
        color: var(--ink);
        padding-top: 12px;
        border-top: 1px solid var(--rule);
      }

      /* Footer: one small centred line, like a handle. */
      .colophon {
        flex: none;
        margin-top: 22px;
        text-align: center;
        font-family: var(--mono);
        font-size: 19px;
        letter-spacing: 0.02em;
        color: var(--muted);
      }

      /* Shown above the frame when the essay cannot fit at a legible size. */
      .too-long { display: none; color: #ffb4a2; font-weight: 600; }
      [data-overflow='1'] .too-long { display: block; }

      @media print {
        .help { display: none; }
        body { background: #ffffff; }
        .share-frame { margin: 0; box-shadow: none; }
      }
    </style>
  <script is:inline data-posthog-fleet>(function(){if(window.__posthogFleet)return;window.__posthogFleet=1;var s=document.createElement('script');s.async=true;s.src='https://us-assets.i.posthog.com/static/array.js';s.onload=function(){if(!window.posthog||!window.posthog.init)return;window.posthog.init('phc_FCpCP9mIsb9IcxpX0Qqi6FmJ48sVvscAYIrZmtRHIq4',{api_host:'https://us.i.posthog.com',person_profiles:'identified_only',capture_pageview:'history_change',capture_pageleave:true,autocapture:false,disable_session_recording:true,disable_surveys:true,loaded:function(p){p.register({site:location.hostname})}});};document.head.appendChild(s);})();</script>
</head>
  <body>
    <p class="help">
      Screenshot the framed essay (Cmd+Shift+4 on Mac · Win+Shift+S on Windows) and post to X / IG.
      The frame is exactly <code>1080 × 2160</code> and the text is sized to fill it.
      <span class="too-long">This essay is too long for one frame at a readable size. Cut it down.</span>
      <a href={`/posts/${post.slug}/`}>back to the post</a>
    </p>

    <article class="share-frame">
      <header class="head">
        <span class="mark" aria-hidden="true">P</span>
        <h1 class="headline">{data.title}</h1>
      </header>

      <div class="prose">
        <Content />
      </div>

      {data.bullets && data.bullets.length > 0 && (
        <section class="takeaways">
          <p class="takeaways-label">Takeaways</p>
          <ul class="takeaways-grid">
            {data.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </section>
      )}

      <footer class="colophon">
        {data.number !== undefined && `№ ${String(data.number).padStart(3, '0')} · `}pangaea.blog/posts/{post.slug}
      </footer>
    </article>

    <script is:inline>
      // Fit the body to the frame: pick the largest --fs (px) at which the
      // prose does not overflow, between MIN and MAX. Below MIN the essay is
      // too long for one screenshot and the page says so.
      (function () {
        var MIN = 24, MAX = 46;
        var frame = document.querySelector('.share-frame');
        var prose = frame.querySelector('.prose');
        function fits(px) {
          frame.style.setProperty('--fs', px + 'px');
          return prose.scrollHeight <= prose.clientHeight;
        }
        function fit() {
          var lo = MIN, hi = MAX;
          if (!fits(lo)) {
            document.documentElement.dataset.overflow = '1';
            return;
          }
          delete document.documentElement.dataset.overflow;
          if (fits(hi)) return;
          while (hi - lo > 0.25) {
            var mid = (lo + hi) / 2;
            if (fits(mid)) lo = mid; else hi = mid;
          }
          fits(lo);
        }
        fit();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
        window.addEventListener('load', fit);
      })();
    </script>
  </body>
</html>
